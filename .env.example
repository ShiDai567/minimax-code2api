# Copy to .env before `docker compose up`. ENCRYPTION_KEY is required.
# Generate one with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-to-a-long-random-token
ENCRYPTION_KEY=

# Console login password. The login page asks for this and nothing else.
CONSOLE_PASSWORD=

ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8045

# Optional, JSON objects keyed by region (cn, global). Leave unset until verified.
# BALANCE_ADAPTERS={"cn":{"url":"https://example.invalid/balance","field":"credits","unit":"credits"}}
# MODEL_DISCOVERY_URLS={"cn":"https://example.invalid/v1/models"}
