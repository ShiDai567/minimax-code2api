# 至少 32 字符。管理端 Bearer，与网关 API Key 不是同一套。
ADMIN_TOKEN=
# Fernet key: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=
DJANGO_SECRET_KEY=
DATABASE_URL=mysql://code2api:code2api@127.0.0.1:3306/code2api
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MCODE_APP_VERSION=0.1.0
UPSTREAM_TIMEOUT_SECONDS=30
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8045
# 可选，必须是已核实的 HTTPS，且不含账号密码。未配置时余额同步与模型发现返回 501。
# BALANCE_ADAPTERS={"cn":{"url":"https://trusted.example/plan","field":"data.remaining","unit":"tokens"}}
# MODEL_DISCOVERY_URLS={"cn":"https://trusted.example/v1/models"}
# 控制台登录密码。页面只要求输入密码，不入库。留空则登录接口返回 503，脚本仍可用 ADMIN_TOKEN。
CONSOLE_PASSWORD=
